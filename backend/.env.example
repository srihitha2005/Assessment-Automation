# PostgreSQL used by the FastAPI service
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/assessment_automation

# The only local LLM used by this project
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional Google Sheets source of truth. Without these, sample data from Design.pdf is used.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Optional target assessment portal endpoint. Without it, Publish updates only this system.
PORTAL_PUBLISH_URL=
