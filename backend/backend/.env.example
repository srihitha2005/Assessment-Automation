# Database — default is SQLite at backend/backend.db.
# Set to postgresql+psycopg://... to use Postgres (same schema on either).
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/assessment_automation

# Local LLM (used for question classification and generation).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_CLASSIFY_BATCH_SIZE=8

# Optional Google Sheets source of truth. Without these, the bundled fallback
# dataset (10 planners, 30 chapters) is used.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Optional assessment portal integration. Without a URL, Publish writes a signed
# JSON artifact to generated_documents/portal_<id>.json (demo mode).
PORTAL_PUBLISH_URL=
PORTAL_API_KEY=
PORTAL_TIMEOUT_SECONDS=30
PORTAL_MAX_RETRIES=3

# Flip features.
BOOTSTRAP_DEMO_DATA=true
ENABLE_PDF_EXPORT=true

# CORS: * in dev; set to your frontend origin in prod.
FRONTEND_ORIGIN=*
